# --- TrustHost Customer API (client area → Account → API Access) -------------
TRUSTHOST_BASE_URL=https://my.trusthost.co/api/v1
TRUSTHOST_API_KEY=
TRUSTHOST_API_SECRET=

# --- Telegram -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to use the bot (owner/admin only)
ADMIN_TELEGRAM_IDS=

# --- Database -------------------------------------------------------------------
# Production (docker-compose): postgresql+asyncpg://user:password@postgres:5432/trusthost_bot
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/trusthost_bot
# Local development alternative:
# DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Used by docker-compose for the bundled PostgreSQL container
POSTGRES_USER=trusthost
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trusthost_bot

# --- Optional tuning ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
# TrustHost allows 60 requests/minute for keys without an IP allow-list; keep headroom.
TRUSTHOST_MAX_REQUESTS_PER_MINUTE=50
TRUSTHOST_TIMEOUT_SECONDS=15
# How often tickets / services / invoices are polled for notifications (minutes)
NOTIFICATION_POLL_MINUTES=5
DEFAULT_LANGUAGE=en
